PORT=8790
UPLOADS_DIR=./data/uploads
APP_TOKEN=replace-with-a-long-random-secret

# Optional AI/web enrichment
OPENAI_API_KEY=
# Optional alternative: name an existing secret environment variable.
OPENAI_API_KEY_ENV=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Eventernote credentials stay on the server. Writes are disabled by default.
EVENTERNOTE_ORIGIN=https://www.eventernote.com
EVENTERNOTE_USERNAME=
EVENTERNOTE_PASSWORD=
EVENTERNOTE_WRITE_ENABLED=false

# Internal eventernote-dashboard API
DASHBOARD_API_URL=http://eventernote-api:8787
DASHBOARD_IMPORT_TOKEN=
DASHBOARD_USER_ID=
